# ---------------------------------------------------------------
# Canary Interior Design — environment configuration
# Copy to .env.local (development) or set in your hosting dashboard.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; all
# others stay on the server. Never commit real secrets.
# ---------------------------------------------------------------

# Production URL — used for canonical URLs, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.canaryinterior.ae

# Set to "false" on staging/preview deployments to block indexing.
# Leave unset (or "true") in production.
NEXT_PUBLIC_ALLOW_INDEXING=true

# --- Enquiry delivery (configure at least one) -----------------
# 1) Email via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=info.canaryid@gmail.com
ENQUIRY_FROM_EMAIL="Canary Website <enquiries@canaryinterior.ae>"

# 2) Webhook to a CRM / Zapier / Make scenario (receives JSON)
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# --- Analytics (optional; nothing loads if both are empty) -----
# Use ONE of these. GTM takes precedence if both are set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# --- Google Search Console verification (optional) -------------
NEXT_PUBLIC_GSC_VERIFICATION=
